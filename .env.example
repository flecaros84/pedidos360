# =====================================================
# Pedidos360 - ejemplo de variables de producción
# Copiar a .env solo en la máquina de despliegue.
# NO subir .env al repositorio.
# =====================================================

# Imágenes Docker
GHCR_OWNER=tu_usuario_github_en_minusculas
IMAGE_TAG=latest

# Seguridad: local | azure
APP_SECURITY_MODE=azure

# Microsoft Entra ID / Azure AD
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Debe coincidir exactamente con el claim "iss" del access token.
# Puede ser formato v1 (https://sts.windows.net/<tenant>/) o v2
# (https://login.microsoftonline.com/<tenant>/v2.0).
AZURE_ISSUER_URI=
# Debe coincidir exactamente con el claim "aud" del access token.
AZURE_AUDIENCE=
# Ejemplo: api://<application-client-id>/pedidos360.access
AZURE_API_SCOPE=
# Opcional. Si queda vacío, el frontend usa window.location.origin.
AZURE_REDIRECT_URI=

# URLs públicas que usa el navegador.
# En la versión final ambas pueden apuntar al mismo AWS API Gateway.
AUTH_API_URL=http://localhost:8081
CART_API_URL=http://localhost:8082

# Origen autorizado por CORS en los backends.
# Ejemplo final: https://xxxxxxxx.execute-api.us-east-1.amazonaws.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# Base de datos del Cart Service
DATABASE_URL=jdbc:postgresql://localhost:5432/pedidos360
DATABASE_USERNAME=pedidos360
DATABASE_PASSWORD=pedidos360
