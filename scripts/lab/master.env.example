# Copy to master.env outside Git; supply your own values. NEVER commit secrets.
AWS_REGION=us-east-1
AZURE_TENANT_ID=TENANT-ID
AZURE_CLIENT_ID=CLIENT-ID
AZURE_API_SCOPE=api://CLIENT-ID/pedidos360.access
AZURE_AUDIENCE=CLIENT-ID
DATABASE_PASSWORD=STRONG-PRIVATE-PASSWORD-MATCHING-TERRAFORM-RDS
RABBITMQ_USERNAME=pedidos360
RABBITMQ_PASSWORD=STRONG-PRIVATE-RABBITMQ-PASSWORD
INTERNAL_SERVICE_TOKEN=LONG-RANDOM-SERVICE-TO-SERVICE-SECRET
ANTIFRAUD_HMAC_KEY=LONG-RANDOM-HMAC-SECRET-AT-LEAST-16-CHARS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=SMTP-USER
SMTP_PASSWORD=SMTP-PRIVATE-PASSWORD
SMTP_FROM=verified-sender@example.com
# Transbank Webpay Plus integration credentials (NOT production secrets).
WEBPAY_COMMERCE_CODE=INTEGRATION-COMMERCE-CODE
WEBPAY_API_KEY=INTEGRATION-API-KEY
WEBPAY_API_BASE=https://webpay3gint.transbank.cl/rswebpaytransaction/api/webpay/v1.2
