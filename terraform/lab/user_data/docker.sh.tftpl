#!/bin/bash
set -euxo pipefail
dnf install -y docker curl jq
systemctl enable --now docker
mkdir -p /opt/pedidos360
# Install a templated service only after runtime environment secrets are supplied.
cat >/etc/systemd/system/pedidos360.service <<'UNIT'
[Unit]
Description=Pedidos360 ${service_name} container
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/pedidos360/start.sh
ExecStop=/usr/bin/docker stop pedidos360-${service_name}
TimeoutStartSec=240
[Install]
WantedBy=multi-user.target
UNIT
cat >/opt/pedidos360/start.sh <<'START'
#!/bin/bash
set -euo pipefail
[ -f /opt/pedidos360/service.env ] || exit 0
/usr/bin/docker rm -f pedidos360-${service_name} 2>/dev/null || true
# The image tag can be updated without modifying Terraform/EC2 user-data.
TAG="$(sed -n 's/^IMAGE_TAG=//p' /opt/pedidos360/service.env | tail -1)"
IMAGE="${docker_image}"
if [ -n "$TAG" ] && [ "${service_name}" != rabbitmq ] && [ "${service_name}" != kafka ]; then
  # Only override application image tags; official broker tags must be preserved.
  IMAGE="$${IMAGE%:*}:$TAG"
fi
EXTRA=""
if [ "${service_name}" = rabbitmq ]; then
  mkdir -p /opt/pedidos360/rabbitmq-data
  EXTRA="-p 5672:5672 -v /opt/pedidos360/rabbitmq-data:/var/lib/rabbitmq"
fi
if [ "${service_name}" = kafka ]; then
  mkdir -p /opt/pedidos360/kafka-data
  EXTRA="-v /opt/pedidos360/kafka-data:/var/lib/kafka/data"
fi
/usr/bin/docker pull "$IMAGE"
# EXTRA is deliberately word-split into fixed, trusted port/volume flags.
/usr/bin/docker run -d --name pedidos360-${service_name} --restart unless-stopped --env-file /opt/pedidos360/service.env \
  -p ${service_port}:${service_port} $EXTRA "$IMAGE"
START
chmod 700 /opt/pedidos360/start.sh
cat >/opt/pedidos360/configure.sh <<'CONFIG'
#!/bin/bash
set -euo pipefail
# LabInstanceProfile must be allowed to read this SSM SecureString parameter.
aws ssm get-parameter --name /pedidos360/lab/${service_name}/env --with-decryption \
  --query 'Parameter.Value' --output text >/opt/pedidos360/service.env
chmod 600 /opt/pedidos360/service.env
CONFIG
chmod 700 /opt/pedidos360/configure.sh
systemctl daemon-reload
systemctl enable pedidos360.service
